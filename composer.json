{
    "name": "easyswoole/ip-access",
    "description": "a simple white/black access manager",
    "type": "library",
    "keywords": [
        "php ip access",
        "php ip block"
    ],
    "license": "Apache-2.0",
    "autoload": {
        "psr-4": {
            "EasySwoole\\IpAccess\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EasySwoole\\IpAccess\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    }
}
